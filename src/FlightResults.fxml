<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="application.FlightResultsController">
    <children>
        <TableView fx:id="flightsTable" layoutX="25.0" layoutY="25.0" prefHeight="550.0" prefWidth="950.0">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="150.0" text="Date" />
                <TableColumn fx:id="colCarrier" prefWidth="60.0" text="Carrier" />
                <TableColumn fx:id="colFlightNum" prefWidth="60.0" text="Flight #" />
                <TableColumn fx:id="colOrigin" prefWidth="200.0" text="From" />
                <TableColumn fx:id="colDest" prefWidth="200.0" text="To" />
                <TableColumn fx:id="colDepTime" prefWidth="60.0" text="Dep Time" />
                <TableColumn fx:id="colArrTime" prefWidth="60.0" text="Arr Time" />
                <TableColumn fx:id="colCancelled" prefWidth="60.0" text="Cancelled" />
                <TableColumn fx:id="colDiverted" prefWidth="60.0" text="Diverted" />
            </columns>
        </TableView>
        <Button layoutX="844.0" onAction="#handlePreviousPage" text="Previous" />
		<Button layoutX="918.0" onAction="#handleNextPage" text="Next" />
    </children>
</AnchorPane>
