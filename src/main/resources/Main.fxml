<!-- Departure Time Range -->
<AnchorPane layoutX="35.0" layoutY="200.0" prefWidth="300.0">
    <children>
        <VBox alignment="TOP_LEFT" spacing="10.0">
            <Label text="Select time range for departure:" textFill="WHITE" />
            <RangeSlider fx:id="rangeSlider" blockIncrement="30" lowValue="0" majorTickUnit="240" max="1440" min="0" minorTickCount="3" prefWidth="250.0" showTickLabels="true" showTickMarks="true" snapToTicks="true" />

<!--  
            <Label fx:id="lowValueLabel" text="Start: 08:00" textFill="WHITE" />
            <Label fx:id="highValueLabel" text="End: 17:00" textFill="WHITE" />
-->            
        </VBox>
    </children>
</AnchorPane>

<!-- Arrival Time Range -->
<AnchorPane layoutX="335.0" layoutY="200.0" prefWidth="300.0">
    <children>
        <VBox alignment="TOP_LEFT" spacing="10.0">
            <Label text="Select time range for arrival:" textFill="WHITE" />
            <RangeSlider fx:id="rangeSlider2" blockIncrement="30" lowValue="0" majorTickUnit="240" max="1440" min="0" minorTickCount="3" prefWidth="250.0" showTickLabels="true" showTickMarks="true" snapToTicks="true" />

<!--             
            <Label fx:id="lowValueLabel2" text="Start: 08:00" textFill="WHITE" />
            <Label fx:id="highValueLabel2" text="End: 17:00" textFill="WHITE" />
-->                        
        </VBox>
    </children>
</AnchorPane>

	  
	  <AnchorPane layoutX="705.0" layoutY="120.0" prefWidth="300.0">
   <children>
      <VBox alignment="TOP_LEFT" spacing="10.0">
         <Label text="Select a preference:" textFill="WHITE" />
         
         <!-- RadioButtons -->
         <RadioButton fx:id="option1" style="-fx-text-fill: white;" text="Show cancelled flights" />
         <RadioButton fx:id="option2" style="-fx-text-fill: white;" text="Show diverted flights" />
      </VBox>
   </children>
</AnchorPane>
	  
	  <Label layoutX="447.0" layoutY="266.0" text="Search by Flight:" textFill="WHITE" />
<TextField fx:id="flightSearchField" layoutX="447.0" layoutY="291.0" prefWidth="350.0" promptText="e.g. AA3844" />

