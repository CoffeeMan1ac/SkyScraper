<AnchorPane id="mainPane" fx:id="mainPane" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.Controller">
   <children>
      <Button fx:id="graphsButton" layoutX="35.0" layoutY="-255.0" mnemonicParsing="false" onAction="#switchToGraphs" text="Generate Graph">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <ComboBox fx:id="cityComboBox" layoutX="35.0" layoutY="-210.0" prefWidth="300.0" />
      <Label layoutX="42.0" layoutY="-185.0" text="Select Origin City:" textFill="WHITE" />

      <VBox alignment="TOP_CENTER" spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="20.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" />
         </padding>
         <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button mnemonicParsing="false" onAction="#openDataset" text="Open dataset…" />
         </HBox>
         <Text fill="WHITE" opacity="0.85" stroke="BLACK" strokeWidth="0.4" text="SkyScraper">
            <font>
               <Font name="OCR A Extended" size="50.0" />
            </font>
         </Text>
         <HBox alignment="CENTER" spacing="10.0">
            <ComboBox fx:id="carrierComboBox" prefWidth="140.0" promptText="Carrier" />
            <ComboBox fx:id="originCityComboBox" prefWidth="180.0" promptText="Origin" />
            <ComboBox fx:id="destinationCityComboBox" prefWidth="180.0" promptText="Destination" />
            <Button fx:id="timeButton" mnemonicParsing="false" onAction="#openTimePopover" prefWidth="180.0" text="Time" />
            <CheckBox fx:id="option1" text="Cancelled" />
            <CheckBox fx:id="option2" text="Diverted" />
            <Button mnemonicParsing="false" onAction="#handleSearchFlights" prefWidth="100.0" text="Search" />
            <ToggleButton fx:id="mapHeatmapToggle" mnemonicParsing="false" onAction="#toggleMapHeatmap" prefWidth="100.0" text="Heatmap" />
         </HBox>
         <HBox alignment="CENTER" spacing="10.0">
            <Label text="🔍">
               <font><Font size="20.0" /></font>
            </Label>
            <TextField fx:id="flightSearchField" prefWidth="400.0" promptText="Flight # e.g. AA3844" />
         </HBox>
         <Separator prefWidth="600.0" />
         <Label fx:id="mapDescriptionLabel" text="Click an airport to view its destinations" textFill="WHITE" />
         <HBox fx:id="heatmapLegend" alignment="CENTER" managed="true" spacing="8.0" visible="false">
            <Label text="Few" textFill="WHITE" />
            <Rectangle fx:id="legendBar" arcHeight="3.0" arcWidth="3.0" height="10.0" width="180.0" />
            <Label text="Many" textFill="WHITE" />
            <Region prefWidth="20.0" />
            <Rectangle arcHeight="2.0" arcWidth="2.0" fill="#d6d0c4" height="10.0" width="10.0" />
            <Label text="N/A" textFill="WHITE" />
         </HBox>
	  
	  
	  <StackPane fx:id="mapArea" maxHeight="449.0" maxWidth="763.0" minHeight="449.0" minWidth="763.0" prefHeight="449.0" prefWidth="763.0">
	    <children>
	      <Pane fx:id="mapContainer" prefHeight="449.0" prefWidth="763.0" />
	      <fx:include fx:id="flightDetails" source="FlightDetails.fxml" />
	    </children>
	  </StackPane>
         <HBox fx:id="dotSearchRow" alignment="CENTER" spacing="10.0">
            <Label text="Search airports:" textFill="WHITE" />
            <TextField fx:id="dotSearchField" prefWidth="300.0" promptText="IATA, city, or state" />
         </HBox>
      </VBox>
