   <children>
      <VBox alignment="CENTER" layoutX="0.0" layoutY="20.0" prefWidth="1200.0" spacing="10.0">
         <children>
            <!--
            <Text fill="WHITE" opacity="0.85" stroke="BLACK" strokeWidth="0.4" text="SkyScraper">
