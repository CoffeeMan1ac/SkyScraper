<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.web.WebView?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="application.HeatmapViewer">
    <children>
        <!-- WebView to display the SVG -->
        <WebView fx:id="webView" layoutX="220.0" layoutY="104.0" prefHeight="550.0" prefWidth="760.0" />

        <!-- Button to trigger heatmap generation -->
        <Button layoutX="536.0" layoutY="670.0" onAction="#showHeatmap" text="Generate Heatmap" />
        <Button layoutX="14.0" layoutY="13.0" mnemonicParsing="false" onAction="#switchToMainFromHeatmap" text="Main menu" />
    </children>
</AnchorPane>
