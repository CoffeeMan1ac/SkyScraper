<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="449.0" maxWidth="763.0" minHeight="449.0" minWidth="763.0" prefHeight="449.0" prefWidth="763.0" style="-fx-background-color: #A7A8AA;" visible="false" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.FlightDetailsController">
   <children>
      <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label style="-fx-font-size: 24px; -fx-text-fill: black;" text="Flight Details" />
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label fx:id="detailsLabel" prefWidth="300.0" style="-fx-font-size: 14px; -fx-text-fill: black; -fx-border-color: black; -fx-border-width: 0.5; -fx-padding: 10px;" wrapText="true" />
                  <ImageView fx:id="airlineLogo" fitHeight="100.0" fitWidth="100.0" preserveRatio="true" />
               </children>
            </HBox>
            <Button onAction="#closeFlightDetails" text="Back to map" />
         </children>
      </VBox>
   </children>
</AnchorPane>
