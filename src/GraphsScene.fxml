<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ControllerGraphs">
   <children>
      <Text fill="WHITE" layoutX="470.0" layoutY="60.0" opacity="0.85" stroke="BLACK" strokeWidth="0.4" text="SkyScraper">
         <font>
            <Font name="OCR A Extended" size="50.0" />
         </font>
      </Text>
      <Button layoutX="14.0" layoutY="13.0" mnemonicParsing="false" onAction="#switchToMain" text="Main menu" />
      <Label fx:id="debugLabel" layoutX="14.0" layoutY="75.0" text="Debug info here" textFill="WHITE" />
      <Label fx:id="sqlLabel" layoutX="14.0" layoutY="100.0" text="Origin City:" textFill="WHITE">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <BarChart fx:id="barChart" layoutX="50.0" layoutY="130.0" prefHeight="620.0" prefWidth="1100.0">
         <xAxis>
            <NumberAxis label="Number of Flights" tickLabelFill="WHITE" />
         </xAxis>
         <yAxis>
            <CategoryAxis label="Destination City" tickLabelFill="WHITE" />
         </yAxis>
      </BarChart>
   </children>
</AnchorPane>
